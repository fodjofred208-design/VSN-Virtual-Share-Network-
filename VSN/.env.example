# VSN — Environment Variables Template
# Copy to `.env` and fill in real values. NEVER commit `.env`.

# ── Database (control-plane persistence) ────────
# PostgreSQL connection string used by Drizzle + `pg`.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/vsn

# ── Authentication / tokens ─────────────────────
# Secret used to sign session tokens (JWT). Use a long random string in prod.
AUTH_SECRET=change-me-to-a-long-random-string

# Lifetime of a session token in seconds (default 3600 = 1h).
TOKEN_TTL_SECONDS=3600

# Challenge nonce lifetime in seconds (default 300 = 5min).
CHALLENGE_TTL_SECONDS=300

# ── Signaling / real-time plane ─────────────────
# Public origin/port the WebSocket signaling server is reachable at.
SIGNALING_URL=ws://localhost:3002
SIGNALING_PORT=3002

# ── Control plane / app ─────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3000

# ── Data plane / VSN Agent (local, never exposed) ─
# Where the local VSN Agent exposes its IPC/local API to the UI.
AGENT_IPC_URL=http://127.0.0.1:4173

# ── Optional: relay / region metadata ───────────
# NODE_ENV is set automatically by Next.js.
